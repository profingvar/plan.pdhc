POSTGRES_USER=pdhc_admin
POSTGRES_PASSWORD=CHANGE_ME
# DB name is "pdhc_gateway" — legacy name retained for data continuity
# (rollup #325 / ticket #336). Pre-2026 the service was called
# "PDHC Gateway"; renaming the volume would risk data loss (see
# CLAUDE.md memory feedback_db_safety.md).
POSTGRES_DB=pdhc_gateway
DATABASE_URL=postgresql://pdhc_admin:CHANGE_ME@localhost:9031/pdhc_gateway
FLASK_SECRET_KEY=CHANGE_ME
BOOTSTRAP_SU_USERNAME=admin
BOOTSTRAP_SU_PASSWORD=CHANGE_ME
FLASK_ENV=development
FLASK_PORT=9030
# Set to false for production/SSO deployment
AUTH_DISABLED=true

# Forms builder API key (for external service-to-service access to /api/v1/forms)
API_KEY=change-me-builder-api-key

# SSO integration (used when AUTH_DISABLED=false).
# Local dev: leave AUTH_DISABLED=true above to bypass SSO entirely.
SSO_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=plan_pdhc_local
SSO_CLIENT_SECRET=replace_me
SSO_CALLBACK_URL=http://localhost:9030/api/v1/auth/callback

# ------------------------------------------------------------------
# Guided PlanDef authoring assistant (epic #516) — OPT-IN, default OFF.
# When disabled the /api/v1/authoring/* endpoints report "disabled" and
# nothing about existing PlanDef/Concept saving changes.
# ------------------------------------------------------------------
AUTHORING_ASSISTANT_ENABLED=false
# Anthropic Messages API key. Leave blank to run validation-only (Layer 1)
# without the Claude assistant (Layer 2). NEVER commit a real key.
ANTHROPIC_API_KEY=
# Selectable Claude models (allowlist, comma-separated) + default.
AUTHORING_ASSISTANT_MODELS=claude-sonnet-5,claude-opus-4-8,claude-haiku-4-5-20251001
AUTHORING_ASSISTANT_DEFAULT_MODEL=claude-sonnet-5

# ------------------------------------------------------------------
# openEHR-realisability check (#523): the builder's "Check openEHR export"
# button proxies to rosetta.pdhc's /api/v1/openehr/realisable.
# ------------------------------------------------------------------
ROSETTA_BASE_URL=https://rosetta.pdhc.se
# SHARED SECRET — must be byte-identical to rosetta's ROSETTA_SERVICE_KEY,
# sent as the X-Service-Key header. blank on both = endpoint open; set on both
# = auth required. ROTATION: change here AND in rosetta's .env, then recreate
# BOTH containers (docker compose up -d --force-recreate app). NEVER commit a
# real key — .env is gitignored.
ROSETTA_SERVICE_KEY=

# ------------------------------------------------------------------
# #530 — Transfer page: promote synthetic cdr_6 content into a working CDR.
# plan.pdhc only TRIGGERS; the transfer runs server-side in cdr_6 (#529).
# cdr_6 is sim-only (its Rule 2), so plan calls it as X-Source-Service:
# sim.pdhc — CDR6_SERVICE_KEY MUST equal cdr_6's SIM_PDHC_SERVICE_KEY.
# On miserver, cdr_6 is reachable at host.docker.internal:9055 (container →
# host loopback). Both blank = the Transfer page reports "not configured".
# ------------------------------------------------------------------
CDR6_BASE_URL=
CDR6_SERVICE_KEY=
# CDR6_TIMEOUT=120
# CDR_TRANSFER_TARGETS=cdr1,cdr2,cdr3,cdr4,cdr5

# #521 GA-5 — fail-closed validation on concept/plandef saves. true (default) =
# ERROR-severity issues reject the save (warnings pass); admins may force with
# override_validation=1 (audited). Set false as a kill-switch.
PLANDEF_VALIDATION_ENFORCED=true
